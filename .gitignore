# Root .gitignore for EmSmart repository

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# Node
node_modules/
**/node_modules/

# Databases and local build artifacts
**/emsmart.db
*.sqlite3
**/dist/

# Logs and runtime files
*.log
logs/
backend/logs/
!backend/logs/.gitkeep

# IDEs / OS
.vscode/
.idea/
*.suo
*.ntvs*
*.DS_Store
Thumbs.db

# NPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.bak
*.tmp

# 后端备份/临时文件
backend/main_legacy.py

# End
