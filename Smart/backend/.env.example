# ============================================
# 智能工厂工作任务管理平台 - 环境配置模板
# 将此文件复制为 .env 并修改为实际值
# ============================================

# ---------- 数据库配置 ----------
# SQL Server 连接信息
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=WorkTaskDB
DB_USER=sa
DB_PASSWORD=YourPassword123

# ODBC 驱动名称，Windows 默认
DB_DRIVER=ODBC Driver 17 for SQL Server
# 对于 Linux/Mac，可能需要不同的驱动名称，如：
# DB_DRIVER=ODBC Driver 18 for SQL Server

# ---------- JWT 认证 ----------
# JWT 密钥，生产环境请改为随机字符串
SECRET_KEY=your-production-secret-key-change-this

# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- 应用配置 ----------
# 应用标题
APP_TITLE=智能工厂工作任务管理平台

# 应用版本
APP_VERSION=1.0.0