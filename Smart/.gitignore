# ============================================================
# 智能工厂工作任务管理平台 —— 通用忽略
# ============================================================

# -------- Python --------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.tox/
*.log
backend/logs/*
!backend/logs/.gitkeep

# -------- Python venv --------
venv/
.venv/
env/

# -------- 本地环境变量（含机密） --------
backend/.env
frontend/.env
.env.*
!.env.example

# -------- 前端构建产物（按项目约定，构建产物由 CI / 开发者本地生成，一般不入库） --------
frontend/dist/
frontend/node_modules/
**/node_modules/

# -------- IDE / OS --------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# -------- 后端备份/临时文件 --------
backend/main_legacy.py   # 历史入口备份（不应入库）

# -------- 本地数据文件 --------
data/*.db
